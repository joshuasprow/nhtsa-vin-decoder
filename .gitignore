# goreleaser's output and the C libraries its before hook builds
# (.goreleaser.yaml). Ignored, so a release build's tree stays clean and Go
# stamps the tag, not "+dirty", as the version.
/dist/
/build/
# Zig's local cache, should anything point it into the checkout (mlugg/setup-zig
# did, and in v0.1.0 every build after the first one was "+dirty").
/.zig-cache/
# scripts/bench.sh corgi installs corgi here (npm ci).
/bench/decode/node_modules/
