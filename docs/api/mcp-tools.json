{
  "tools": [
    {
      "name": "decode_vin",
      "title": "Decode VIN",
      "description": "Decode one VIN (vehicle identification number) offline against NHTSA's vPIC data, with the answers NHTSA's own decoder gives: make, model, model year, body, engine, plant and every other vPIC element.\n\nA wrong VIN is never refused: a mistyped, short or partial VIN (* for an unknown position) still decodes, and what is wrong with it is in error_codes ([0] is clean), the Error Text attribute and corrected_vin. Check error_codes before trusting the result.\n\nValues are NHTSA's exact strings. An element that did not decode is \"\" (shape vpic) or absent (shape nitrovin): report it as unknown, never infer it.\n\n- model_year: only a year the user knows apart from the VIN (title, registration). A disagreement adds error code 12.\n- shape: \"vpic\" (default) is vPIC's DecodeVinValues layout, keyed by element code, every element present. \"nitrovin\" keys by variable name, lists only decoded elements, and gives multi-valued ones such as Note as arrays.\n- full: adds items, every row behind the decode with its source. Large; use only when asked where a value came from.\n- now: omit. Set it only to reproduce an earlier decode, from that decode's now.\n\nDecode several VINs with one call each. data_month in the result names the NHTSA data the answer comes from.",
      "inputSchema": {
        "type": "object",
        "$ref": "#/$defs/DecodeRequest",
        "$defs": {
          "DecodeRequestFields": {
            "type": "object",
            "required": [
              "vin"
            ],
            "properties": {
              "vin": {
                "type": "string",
                "minLength": 1,
                "description": "1-17 characters after trimming spaces: vPIC's spvindecode holds the trimmed VIN in a varchar(17) and raises on a longer one. Any such string decodes; partial ('*') and mistyped VINs return error codes, not a refusal."
              },
              "model_year": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": -2147483648,
                "maximum": 2147483647,
                "description": "The model-year hint (vPIC's modelyear)."
              },
              "full": {
                "type": "boolean",
                "default": false,
                "description": "Add items to the decode."
              },
              "shape": {
                "enum": [
                  "vpic",
                  "nitrovin"
                ],
                "default": "vpic"
              },
              "now": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?([Zz]|[+-][0-9]{2}:[0-9]{2}))?$",
                "description": "Frozen clock: an RFC 3339 instant, or a date meaning 00:00:00Z that day. Fractional seconds are truncated. Absent: the wall clock, read once per request."
              }
            }
          },
          "DecodeRequest": {
            "description": "One decode request: an element of the POST /v1/decode array, a GET's path and query, a C ABI request.",
            "$ref": "#/$defs/DecodeRequestFields",
            "unevaluatedProperties": false
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "$ref": "#/$defs/Decode",
        "$defs": {
          "Decode": {
            "type": "object",
            "required": [
              "vin",
              "wmi",
              "model_year",
              "error_codes",
              "check_digit_valid",
              "corrected_vin",
              "model_year_hint",
              "now",
              "data_month",
              "decoder_version",
              "shape",
              "attributes"
            ],
            "properties": {
              "vin": {
                "type": "string",
                "minLength": 1,
                "maxLength": 17,
                "description": "The VIN as decoded: the request's vin trimmed, uppercased, with every non-ASCII character replaced by '&'."
              },
              "wmi": {
                "type": "string",
                "maxLength": 6,
                "description": "Positions 1-3, plus 12-14 when position 3 is '9' and the VIN has at least 14 characters."
              },
              "model_year": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "The model year the winning pass decoded (element 29); null when none was resolved."
              },
              "error_codes": {
                "type": "array",
                "items": {
                  "type": "integer"
                },
                "minItems": 1,
                "uniqueItems": true,
                "description": "vPIC's error codes (element 143), ascending. [0] is a clean decode."
              },
              "check_digit_valid": {
                "type": "boolean",
                "description": "True when the VIN has at least 17 characters and position 9 equals the computed check digit. A vPIC VinException suppresses error code 1 but leaves this false."
              },
              "corrected_vin": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "vPIC's suggested VIN (element 142, '!' at positions in error); null when that element is empty."
              },
              "model_year_hint": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "The request's model_year, echoed; null when none was given."
              },
              "now": {
                "type": "string",
                "format": "date-time",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
                "description": "The clock this decode used, in UTC whole seconds: the request's now, or the wall clock read once per request."
              },
              "data_month": {
                "type": "string",
                "pattern": "^[0-9]{4}_(0[1-9]|1[0-2])$",
                "description": "The data month of the loaded artifact."
              },
              "decoder_version": {
                "type": "string",
                "minLength": 1,
                "description": "The nitrovin module version that decoded, e.g. 'v1.2.0'; '(devel)' for an untagged build."
              },
              "shape": {
                "enum": [
                  "vpic",
                  "nitrovin"
                ],
                "description": "The layout of attributes, as requested (default 'vpic')."
              },
              "attributes": {
                "description": "The decoded vehicle, laid out per shape."
              },
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/Item"
                },
                "description": "Present only when the request set full: every item the decoder emitted, in item order (docs/api/README.md)."
              }
            },
            "additionalProperties": false,
            "if": {
              "properties": {
                "shape": {
                  "const": "vpic"
                }
              }
            },
            "then": {
              "properties": {
                "attributes": {
                  "$ref": "#/$defs/VpicAttributes"
                }
              }
            },
            "else": {
              "properties": {
                "attributes": {
                  "$ref": "#/$defs/NitrovinAttributes"
                }
              }
            }
          },
          "VpicAttributes": {
            "type": "object",
            "description": "vPIC's DecodeVinValues layout. One key per public element of the data month, named by its element code, always present ('' when undecoded), plus MakeID, ManufacturerId and ModelID. A multi-valued element's distinct values are joined with ', ' in byte order.",
            "propertyNames": {
              "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
            },
            "properties": {
              "MakeID": {
                "type": "string"
              },
              "ManufacturerId": {
                "type": "string"
              },
              "ModelID": {
                "type": "string"
              }
            },
            "required": [
              "MakeID",
              "ManufacturerId",
              "ModelID"
            ],
            "additionalProperties": {
              "type": "string"
            }
          },
          "NitrovinAttributes": {
            "type": "object",
            "description": "Keyed by variable name; only decoded elements are present. A multi-valued element always carries values, every other element value.",
            "propertyNames": {
              "minLength": 1
            },
            "additionalProperties": {
              "oneOf": [
                {
                  "$ref": "#/$defs/SingleAttribute"
                },
                {
                  "$ref": "#/$defs/MultiAttribute"
                }
              ]
            }
          },
          "SingleAttribute": {
            "type": "object",
            "required": [
              "element_id",
              "value"
            ],
            "properties": {
              "element_id": {
                "type": "integer"
              },
              "value": {
                "type": "string",
                "description": "The oracle's exact text; numbers are never retyped."
              },
              "attribute_id": {
                "type": "integer",
                "description": "vPIC's attribute id; present only on lookup elements whose id is an integer (never on Error Code, 143)."
              }
            },
            "additionalProperties": false
          },
          "MultiAttribute": {
            "type": "object",
            "required": [
              "element_id",
              "values"
            ],
            "properties": {
              "element_id": {
                "type": "integer"
              },
              "values": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1,
                "description": "Every attribute of the element, duplicates kept, in byte order."
              }
            },
            "additionalProperties": false
          },
          "Item": {
            "type": "object",
            "description": "One row of spvindecode's output for this VIN, all 15 columns, SQL NULL as null.",
            "required": [
              "group_name",
              "variable",
              "value",
              "pattern_id",
              "vin_schema_id",
              "keys",
              "element_id",
              "attribute_id",
              "created_on",
              "wmi_id",
              "code",
              "data_type",
              "decode",
              "source",
              "to_be_qced"
            ],
            "properties": {
              "group_name": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "groupname"
              },
              "variable": {
                "type": "string",
                "description": "variable"
              },
              "value": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "value"
              },
              "pattern_id": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "itempatternid"
              },
              "vin_schema_id": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "itemvinschemaid"
              },
              "keys": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "itemkeys"
              },
              "element_id": {
                "type": "integer",
                "description": "itemelementid"
              },
              "attribute_id": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "itemattributeid as text: a lookup id, a code list ('1,11,400'), or the raw attribute."
              },
              "created_on": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "itemcreatedon as Postgres renders a timestamp, e.g. '2015-04-21 11:37:26.607'."
              },
              "wmi_id": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "itemwmiid"
              },
              "code": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "code (the element code)"
              },
              "data_type": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "datatype"
              },
              "decode": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "decode"
              },
              "source": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "itemsource, e.g. 'Pattern', 'Conversion 2: 183 * 16.387064 '"
              },
              "to_be_qced": {
                "type": [
                  "boolean",
                  "null"
                ],
                "description": "itemtobeqced"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    }
  ]
}
